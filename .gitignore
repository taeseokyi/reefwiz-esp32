# 파이썬
__pycache__/
*.py[cod]

# 배포가 만드는 것 — tools/deploy.py 가 배포마다 새로 만들어 기기에만 올린다.
#   커밋하면 항상 한 판 뒤처진 커밋 해시를 기기에 심게 된다(버전 표시가 거짓이 된다).
buildinfo.py
src/buildinfo.py

# 개발 서버가 만드는 것
data/*.tmp
data/doser_override_state.json
data/archive/

# 기기 로컬 설정 — 장치 주소(MAC)와 회차는 기기마다 다르다(정비페이지에서 넣는다)
data/devices.json
data/schedule.json
data/bt.json
data/measure_hold.json

# 기기 자격증명 — 절대 커밋하지 않는다(장치의 /data 에만 존재)
data/wifi.json

# 로그
*.log
data/measure_kh.log

# 일회용 진단 스크립트 — 실기를 두드려 보려고 그때그때 만드는 것들(`tools/_btprobe.py`,
#   `tools/_shot.mjs` 등). 저장소에 남길 물건이 아닌데 `git add -A` 에 두 번 딸려 들어갔다.
tools/_*

# 개발 도구(Node) — 정비페이지 브라우저 점검용. 기기에는 올라가지 않는다(deploy 는 src/*.py 만).
tools/node_modules/
tools/package-lock.json

# 원격 배포 설정(토큰 포함) — tools/deploy_wsl.sh 가 만들어 기기에만 올린다
webota.json
